<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="http://maven.apache.org/POM/4.0.0"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <artifactId>interview-kb-ai-view</artifactId>

  <build>
    <plugins>
      <plugin>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <groupId>org.springframework.boot</groupId>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <dependency>
      <artifactId>interview-kb-shared</artifactId>
      <groupId>com.interviewkb</groupId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <artifactId>spring-boot-starter-web</artifactId>
      <groupId>org.springframework.boot</groupId>
    </dependency>
    <dependency>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
      <groupId>org.springframework.boot</groupId>
    </dependency>
    <dependency>
      <artifactId>spring-boot-starter-actuator</artifactId>
      <groupId>org.springframework.boot</groupId>
    </dependency>
    <dependency>
      <artifactId>spring-ai-starter-model-azure-openai</artifactId>
      <groupId>org.springframework.ai</groupId>
    </dependency>
    <dependency>
      <artifactId>spring-ai-starter-vector-store-pgvector</artifactId>
      <groupId>org.springframework.ai</groupId>
    </dependency>
    <dependency>
      <artifactId>spring-boot-starter-test</artifactId>
      <groupId>org.springframework.boot</groupId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <description>AI chat assistant over the knowledge base — Azure OpenAI tool-calling agent,
    read-only
  </description>
  <modelVersion>4.0.0</modelVersion>
  <name>Interview KB – AI View</name>

  <packaging>jar</packaging>

  <parent>
    <artifactId>interview-kb</artifactId>
    <groupId>com.interviewkb</groupId>
    <version>1.1.0-SNAPSHOT</version>
  </parent>

  <properties>
    <!-- SonarCloud only scans compileSourceRoots (src/main/java) by default, so the
         Thymeleaf templates here are invisible to the Java taint-analysis XSS rules
         (e.g. th:utext). Add them explicitly so SonarJava can trace controller output
         into the views it renders. -->
    <sonar.sources>src/main/java,src/main/resources/templates</sonar.sources>
  </properties>

</project>
